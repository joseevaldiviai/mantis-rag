# Copia este archivo a .env y rellena tus valores:
#   cp .env.example .env

OPENAI_API_KEY=sk-...

# Para desarrollo local sin Docker (la app en tu máquina, Postgres en Docker):
DATABASE_URL=postgresql+psycopg2://rag:rag@localhost:5432/rag

EMBEDDING_MODEL=text-embedding-3-small
LLM_MODEL=gpt-4o-mini

# Búsqueda vectorial
TOP_K=5
MIN_RELEVANCE_SCORE=0.0   # 0 = desactivado; sube el umbral (p.ej. 0.55) para afinar

# FAISS: directorio donde se persisten los índices
FAISS_INDEX_DIR=data/faiss

# --- Almacenamiento del archivo original (Firebase Storage / GCS) ---
# Firebase Storage es una capa sobre Google Cloud Storage: al crear el proyecto
# Firebase se crea el bucket <proyecto>.appspot.com. Si GCS_BUCKET está vacío,
# el original NO se guarda: solo se indexan los chunks.
GCS_BUCKET=
# Credenciales de la service account: ruta al JSON...
#GCS_CREDENTIALS=/ruta/clave.json
# ...o el contenido del JSON directamente (más cómodo en Docker):
#GCS_CREDENTIALS_JSON={"type": "service_account", ...}
